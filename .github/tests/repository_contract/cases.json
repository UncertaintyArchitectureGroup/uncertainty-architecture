      "mutation": {
        "type": "delete_path",
        "path": ".github/workflows/publication-render.yml"
      },
      "expected_error": "Missing required file: .github/workflows/publication-render.yml"
    },
    {
      "name": "change coupling workflow deletion is rejected",
      "mutation": {
        "type": "delete_path",
        "path": ".github/workflows/change-coupling.yml"
      },
      "expected_error": "Missing required file: .github/workflows/change-coupling.yml"
    },
    {
      "name": "navigation routing declaration deletion is rejected",
      "mutation": {
        "type": "remove_text",
        "path": ".github/scripts/validate_navigation.py",
        "text": "EXPECTED_NAVIGATION_ROUTES"
      },
      "expected_error": ".github/scripts/validate_navigation.py: missing protected text"
    },
    {
      "name": "self-test manifest deletion is rejected",
      "mutation": {
        "type": "remove_text",
        "path": ".github/tests/repository_contract/test_repository_contract.py",
        "text": "REQUIRED_CASE_NAMES"
      },
      "expected_error": ".github/tests/repository_contract/test_repository_contract.py: missing protected text"
    },
    {
      "name": "preferred citation author deletion is rejected",
      "mutation": {
        "type": "remove_text",
        "path": "CITATION.cff",
        "text": "      given-names: \"Sam\""
      },
      "expected_error": "CITATION.cff: missing protected text"
    },
    {
      "name": "README evidence boundary deletion is rejected",
      "mutation": {
        "type": "remove_text",
        "path": "README.md",
        "text": "Visibility, recommendations, advisory relationships, invited talks, and synthesized examples are not treated as certification, institutional endorsement, formal adoption, or production evidence."
      },
      "expected_error": "README.md: missing protected text"
    },
    {
      "name": "README BibTeX author deletion is rejected",
      "mutation": {
        "type": "remove_text",
        "path": "README.md",
        "text": "  author = {Oborskyi, Vitalii and Walker, Sam},"
