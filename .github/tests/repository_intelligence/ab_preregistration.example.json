    "prompts_sha256": "<64 hex chars>",
    "scoring_key_sha256": "<64 hex chars>",
    "arm_order_seed_sha256": "<64 hex chars>",
    "arm_order_plan_sha256": "<64 hex chars computed from frozen per-task order>",
    "ecological_selection_seed_sha256": "<64 hex chars>",
    "selected_ecological_ids_sha256": "<64 hex chars computed from frozen selected source IDs>"
  },
  "confirmatory": {
    "case_count": 12,
    "paired_run_count": 24,
    "stress_cases": 6,
    "ecological_cases": 6,
    "prompts_sha256": "<64 hex chars>",
    "scoring_key_sha256": "<64 hex chars>",
    "arm_order_seed_sha256": "<64 hex chars>",
    "arm_order_plan_sha256": "<64 hex chars computed from frozen per-task order>",
    "ecological_selection_seed_sha256": "<64 hex chars>",
    "selected_ecological_ids_sha256": "<64 hex chars computed from frozen selected source IDs>",
    "independent_corpus_required": true
  },
  "ecological_source_pool": {
    "mode": "combined_pool|separate_wave_pools",
    "provenance": "<fixed cutoff period or frozen source set>",
    "cutoff_rule": "<exact rule>",
    "raw_pool_sha256": "<64 hex chars>",
    "normalization_contract_version": "RI-AB-NORMALIZE-2",
    "normalization_rule": "make each source task self-contained using only source-context facts; do not add expected owners, paths, validators, canonical terms, RI vocabulary, answer-key facts, or later findings",
    "normalization_before_selection": true,
    "normalized_eligible_pool_sha256": "<64 hex chars>",
    "eligible_pool_count": "<integer >=24 combined, or >=12 per wave>",
    "selection_rule": "<seeded without-replacement allocation across waves>",
    "non_overlap_required": true,
    "task_family_non_overlap_required": true,
    "ecological_source_non_overlap_required": true,
    "anchor_rule": "at least one exact-owner and one legitimate-new-artifact anchor per wave",
    "exclusion_rules": [
      "duplicate task family",
      "depends on unavailable external state",
      "cannot be run identically in both arms",
      "cannot be neutrally normalized without revealing material answer information"
    ]
  },
  "coverage_matrix_rule": {
    "combined_must_cover_every_mandatory_scenario_family": true,
    "confirmatory_must_cover_required_critical_families": true,
    "scenario_assignments_are_frozen_inside_hashed_prompt_packs": true
  },
  "positive_reversal_quality_gate": {
    "minimum_each_applicable_dimension": 1,
    "meaning": "A serious/B no-serious counts toward correctness GO only when every applicable Treatment score dimension is at least this value"
  },
  "primary_endpoint": "paired serious-routing-error status with qualifying Treatment quality",
  "secondary_endpoints": [
    "paired correctness score delta",
    "total connector calls",
    "paired connector-call ratio",
    "default-branch search calls",
    "distinct source files opened",
    "preregistered context-volume metric",
    "equal-correctness ecological connector-cost sensitivity",
    "Treatment delivery and task-level fallback behavior"
  ],
  "ecological_correctness_non_regression": {
    "metric": "median paired total correctness delta B-A",
    "minimum_per_wave": 0,
    "maximum_reverse_serious_error_reversals_per_wave": 0
  },
  "connector_cost_gate": {
    "applies_to": "all valid ecological cases",
    "primary_cost_metric": "total connector calls to final answer",
    "per_case_ratio_formula": "r_i = B_i / A_i",
    "primary_cost_statistic": "median of paired r_i across all six ecological pairs",
    "acceptable_median_ratio_b_over_a": 1.5,
    "high_overhead_ratio_threshold": 2.0,
    "acceptable_high_overhead_case_count": 2,
    "zero_denominator_rule": "0/0 -> 1.0; B>0 with A=0 -> infinity",
    "apply_independently_to_each_wave": true
  },
  "connector_interaction_gain_rule": {
    "maximum_median_ratio_b_over_a_per_wave": 0.8,
    "requires_ecological_correctness_non_regression": true,
    "maximum_reverse_serious_error_reversals": 0,
    "claim_name": "DEMONSTRATED CONNECTOR-INTERACTION GAIN"
  },
  "context_volume": {
    "metric": "repository_response_utf8_bytes|input_tokens|unavailable",
    "must_remain_constant_across_primary_runs": true,
    "measurement_must_be_exact_not_estimated": true,
    "required_for_orientation_efficiency_go": true,
    "maximum_median_ratio_b_over_a_per_wave": 1.0,
    "high_overhead_ratio_threshold": 2.0,
    "acceptable_high_overhead_case_count": 2,
    "complete_for_all_ecological_runs_required": true,
    "unavailable_rule": "orientation-efficiency GO unavailable; connector-interaction gain may still be reported"
  },
  "final_decision_rule": {
    "demonstrated_correctness_go": {
      "minimum_confirmatory_positive_reversals": 1,
      "minimum_confirmatory_ecological_positive_reversals": 1,
      "maximum_confirmatory_reverse_reversals": 0,
      "minimum_combined_positive_reversals": 3,
      "maximum_combined_reverse_reversals": 0,
      "ecological_correctness_non_regression_must_pass_both_waves": true,
      "connector_cost_gate_must_pass_both_waves": true,
      "all_primary_pairs_must_be_valid": true
    },
    "demonstrated_orientation_efficiency_go": {
      "connector_interaction_gain_rule_must_pass_both_waves": true,
      "context_volume_gate_must_pass_both_waves": true,
      "ecological_correctness_non_regression_must_pass_both_waves": true,
      "maximum_reverse_serious_error_reversals_combined": 0,
      "all_primary_pairs_must_be_valid": true
    },
    "regression": "any A-no-serious/B-serious reversal or material ecological non-regression failure",
    "inconclusive": "contrast contamination, source-state, isolation, Treatment identity/delivery, model/client, coverage, scoring, or protocol defect"
  },
  "diagnostic_c": {
    "enabled": false,
    "arm_marker": "RI-AB-DATA-ONLY",
    "timing": "after both primary waves and scores are frozen"
  },
  "post_primary_projection_decomposition": {
    "planned": false,
    "purpose": "optional future diagnostic to separate flat owner/inventory value from relational graph evidence; not part of the primary A/B claim"
  },
  "infrastructure_retry_policy": "none by default; otherwise freeze exact rule before Pilot",
  "stopping_rule": "complete all 48 primary runs unless experiment infrastructure validity fails; never stop for Pilot performance",
  "unblinding_rule": "score arm-hidden copies against the frozen wave key before revealing arms whenever practical"
}
