    },
    "freshness_evidence_reference": "<workflow/job/log or local verification reference>",
    "chunked_connector_delivery_allowed": true,
    "chunk_calls_count_as_connector_cost": true,
    "delivery_failure_rule": "invalidate run; do not score silent fallback as Treatment",
    "task_level_fallback_rule": "valid after successful Treatment delivery; count cost/outcome normally"
  },
  "prompt_pack_schema_version": 2,
