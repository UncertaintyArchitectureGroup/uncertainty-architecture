{
  "contract_version": 1,
  "description": "Repository-contract extension protecting change-coupling, build-integrity, and supply-chain control surfaces.",
  "required_paths": [
    {
      "path": ".github/policy/change-coupling-contract.json",
      "type": "file"
    },
    {
      "path": ".github/scripts/validate_change_coupling.py",
      "type": "file"
    },
    {
      "path": ".github/tests/change_coupling/README.md",
      "type": "file"
    },
    {
      "path": ".github/tests/change_coupling/cases.json",
      "type": "file"
    },
    {
      "path": ".github/tests/change_coupling/test_change_coupling.py",
      "type": "file"
    },
    {
      "path": ".github/workflows/change-coupling.yml",
      "type": "file"
    },
    {
      "path": ".github/dependabot.yml",
      "type": "file"
    },
    {
      "path": ".github/policy/supply-chain-contract.json",
      "type": "file"
    },
    {
      "path": ".github/scripts/validate_mermaid.py",
      "type": "file"
    },
    {
      "path": ".github/scripts/validate_workflow_supply_chain.py",
      "type": "file"
    },
    {
      "path": ".github/tests/supply_chain/cases.json",
      "type": "file"
    },
    {
      "path": ".github/tests/supply_chain/test_supply_chain.py",
      "type": "file"
    },
    {
      "path": ".github/workflows/build-integrity.yml",
      "type": "file"
    },
    {
      "path": ".github/workflows/dependency-review.yml",
      "type": "file"
    },
    {
      "path": ".github/workflows/export-research-pdf.yml",
      "type": "file"
    },
    {
      "path": "quartz/PDF-EXPORT.md",
      "type": "file"
    },
    {
      "path": "quartz/scripts/export-pdf.mjs",
      "type": "file"
    },
    {
      "path": "quartz/scripts/publication-rendition.mjs",
      "type": "file"
    },
    {
      "path": "quartz/scripts/publication-figure8.mjs",
      "type": "file"
    },
    {
      "path": "quartz/scripts/render-publication-pdf.mjs",
      "type": "file"
    },
    {
      "path": "quartz/scripts/render-publication-assets.mjs",
      "type": "file"
    },
    {
      "path": "quartz/scripts/verify-publication-pdf.mjs",
      "type": "file"
    },
    {
      "path": "quartz/scripts/publication-path-safety.mjs",
      "type": "file"
    },
    {
      "path": "quartz/scripts/publication-provenance.mjs",
      "type": "file"
    },
    {
      "path": "quartz/scripts/publication-figure8-fingerprint.mjs",
      "type": "file"
    },
    {
      "path": "quartz/scripts/publication-safety.test.mjs",
      "type": "file"
    },
    {
      "path": "quartz/scripts/run-pdf-export.mjs",
      "type": "file"
    },
    {
      "path": "quartz/scripts/run-publication-assets.mjs",
      "type": "file"
    },
    {
      "path": "quartz/scripts/run-publication-verify.mjs",
      "type": "file"
    }
  ],
  "critical_files": [
    {
      "path": ".github/policy/change-coupling-contract.json",
      "required_text": [
        "\"required_pr_fields\"",
        "\"controlled_values\"",
        "\"notable_change_prefixes\"",
        "\"deletion_rename_prefixes\"",
        "\"exception_labels\""
      ]
    },
    {
      "path": ".github/scripts/validate_change_coupling.py",
      "required_text": [
        "parse_pr_contract",
        "validate_schema",
        "validate_coupling",
        "changed_entries",
        "--pr-body-file",
        "--labels"
      ]
    },
    {
      "path": ".github/tests/change_coupling/test_change_coupling.py",
      "required_text": [
        "REQUIRED_CASE_NAMES",
        "validate_case_manifest",
        "Change coupling self-tests passed"
      ]
    },
    {
      "path": ".github/workflows/change-coupling.yml",
      "required_text": [
        "name: Change coupling",
        "pull_request:",
        "contents: read",
        "name: Contract / diff-aware companion updates",
        "name: Policy / change coupling self-tests",
        "fetch-depth: 0",
        "persist-credentials: false",
        "runs-on: ubuntu-24.04",
        "timeout-minutes: 5"
      ]
    },
    {
      "path": ".github/policy/supply-chain-contract.json",
      "required_text": [
        "\"require_full_commit_sha\": true",
        "\"require_version_comment\": true",
        "\"require_digest\": true",
        "\"digest_algorithm\": \"sha256\""
      ]
    },
    {
      "path": ".github/scripts/validate_workflow_supply_chain.py",
      "required_text": [
        "FULL_SHA_RE",
        "DIGEST_RE",
        "validate_container_reference",
        "Workflow supply-chain validation passed"
      ]
    },
    {
      "path": ".github/tests/supply_chain/test_supply_chain.py",
      "required_text": [
        "REQUIRED_CASE_NAMES",
        "validate_manifest",
        "Supply-chain self-tests passed"
      ]
    },
    {
      "path": ".github/workflows/build-integrity.yml",
      "required_text": [
        "name: Build integrity",
        "Build / Quartz production site",
        "PDF export / regression tests",
        "Publication / current article render",
        "Install Chromium and PDF inspection tools",
        "Visual verify current publication PDF",
        "Render current publication assets",
        "Render living working paper PDF",
        "Visual verify living working paper PDF",
        "Upload publication validation artifact",
        "Content / render Mermaid diagrams",
        "Supply chain / workflows and pins",
        "Run supply-chain regression fixtures",
        "zizmor --pedantic",
        "fetch-depth: 0",
        "UA_PDF_REPOSITORY_REF: ${{ github.sha }}"
      ]
    },
    {
      "path": ".github/workflows/dependency-review.yml",
      "required_text": [
        "name: Dependency review",
        "npm audit --audit-level=critical",
        "actions/dependency-review-action@",
        "Dependency Graph is enabled"
      ]
    },
    {
      "path": ".github/dependabot.yml",
      "required_text": [
        "package-ecosystem: npm",
        "package-ecosystem: github-actions",
        "interval: weekly"
      ]
    },
    {
      "path": "AGENTS.md",
      "required_text": [
        "**Declare** the change in the machine-readable `ua-change-contract` block",
        "The diff-aware companion-update policy lives at [`.github/policy/change-coupling-contract.json`](.github/policy/change-coupling-contract.json).",
        "python3 .github/scripts/validate_change_coupling.py --base <base-sha> --head <head-sha> --pr-body-file <pr-body-file> --labels <comma-separated-labels>",
        "Maintainer exception labels are not a universal override.",
        "Renamed or deleted maintained paths have an explicit compatibility decision."
      ]
    },
    {
      "path": ".github/workflows/export-research-pdf.yml",
      "required_text": [
        "name: Export research PDF",
        "workflow_dispatch:",
        "content/research/notes/thinking-systems-publication-draft.md",
        "npm run pdf:article",
        "npm run publication:assets",
        "npm run pdf:verify",
        "actions/upload-artifact@",
        "fetch-depth: 0",
        "UA_PDF_REPOSITORY_REF: ${{ github.sha }}"
      ]
    },
    {
      "path": "quartz/scripts/publication-path-safety.mjs",
      "required_text": [
        "assertSafeOutputPath",
        "assertIndependentOutputTarget",
        "writeFileAtomically"
      ]
    },
    {
      "path": "quartz/scripts/publication-provenance.mjs",
      "required_text": [
        "determineSourceProvenance",
        "dirty-preview",
        "do not match declared source commit"
      ]
    },
    {
      "path": "quartz/scripts/publication-figure8-fingerprint.mjs",
      "required_text": [
        "canonicalFigure8Fingerprint",
        "requires substantive review"
      ]
    },
    {
      "path": "quartz/scripts/render-publication-pdf.mjs",
      "required_text": [
        "writeFileAtomically",
        "source_state",
        "requireFigure8Split"
      ]
    },
    {
      "path": "quartz/scripts/render-publication-assets.mjs",
      "required_text": [
        "determineSourceProvenance",
        "assertSafeOutputPath",
        "source_state",
        "exactly one Figure 8A"
      ]
    },
    {
      "path": "quartz/scripts/verify-publication-pdf.mjs",
      "required_text": [
        "assertSafeOutputPath",
        "writeFileAtomically",
        "visual-verification.json"
      ]
    },
    {
      "path": "quartz/scripts/run-pdf-export.mjs",
      "required_text": [
        "assertSafeOutputPath",
        "repoRoot, outputRoot, output"
      ]
    },
    {
      "path": "quartz/scripts/run-publication-assets.mjs",
      "required_text": [
        "assertCoverTitleFits",
        "--allow-dirty-preview",
        "repoRoot, publicationRoot, outputRoot"
      ]
    },
    {
      "path": "quartz/scripts/run-publication-verify.mjs",
      "required_text": [
        "assertSafeOutputPath",
        "repoRoot, visualRoot, outputDir"
      ]
    }
  ]
}
