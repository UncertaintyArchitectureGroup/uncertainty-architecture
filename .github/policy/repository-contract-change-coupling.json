{
  "contract_version": 1,
  "description": "Repository-contract extension protecting the diff-aware change-coupling control surfaces.",
  "required_paths": [
    {"path": ".github/policy/change-coupling-contract.json", "type": "file"},
    {"path": ".github/scripts/validate_change_coupling.py", "type": "file"},
    {"path": ".github/tests/change_coupling/README.md", "type": "file"},
    {"path": ".github/tests/change_coupling/cases.json", "type": "file"},
    {"path": ".github/tests/change_coupling/test_change_coupling.py", "type": "file"},
    {"path": ".github/workflows/change-coupling.yml", "type": "file"}
  ],
  "critical_files": [
    {
      "path": ".github/policy/change-coupling-contract.json",
      "required_text": [
        "\"required_pr_fields\"",
        "\"controlled_values\"",
        "\"notable_change_prefixes\"",
        "\"deletion_rename_prefixes\"",
        "\"exception_labels\""
      ]
    },
    {
      "path": ".github/scripts/validate_change_coupling.py",
      "required_text": [
        "parse_pr_contract",
        "validate_schema",
        "validate_coupling",
        "changed_entries",
        "--pr-body-file",
        "--labels"
      ]
    },
    {
      "path": ".github/tests/change_coupling/test_change_coupling.py",
      "required_text": [
        "REQUIRED_CASE_NAMES",
        "validate_case_manifest",
        "Change coupling self-tests passed"
      ]
    },
    {
      "path": ".github/workflows/change-coupling.yml",
      "required_text": [
        "name: Change coupling",
        "pull_request:",
        "contents: read",
        "name: Contract / diff-aware companion updates",
        "name: Policy / change coupling self-tests",
        "fetch-depth: 0",
        "persist-credentials: false",
        "runs-on: ubuntu-24.04",
        "timeout-minutes: 5"
      ]
    },
    {
      "path": "AGENTS.md",
      "required_text": [
        "**Declare** the change in the machine-readable `ua-change-contract` block",
        "The diff-aware companion-update policy lives at [`.github/policy/change-coupling-contract.json`](.github/policy/change-coupling-contract.json).",
        "python3 .github/scripts/validate_change_coupling.py --base <base-sha> --head <head-sha> --pr-body-file <pr-body-file> --labels <comma-separated-labels>",
        "Maintainer exception labels are not a universal override.",
        "Renamed or deleted maintained paths have an explicit compatibility decision."
      ]
    }
  ]
}
